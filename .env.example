# ── MCP Server ──────────────────────────────────────────
PORT=8787
MCP_BEARER_TOKEN=change-me-to-a-random-string

# ── Google (service account) ───────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/google-service-account.json
